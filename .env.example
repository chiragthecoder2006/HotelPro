# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/hotelpro

# Security
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_key

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@hotelpro.com
ADMIN_PASSWORD=AdminPassword123!

# Demo User Credentials
DEMO_USER_NAME=Jane Doe
DEMO_USER_EMAIL=jane@example.com
DEMO_USER_PASSWORD=UserPassword123!

# Optional Payment (Razorpay Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

